    "code": "import { readFileSync } from 'node:fs';\nimport { createHash } from 'node:crypto';\nimport { gzipSync, gunzipSync } from 'node:zlib';\nimport { execFileSync } from 'node:child_process';\nimport { pathToFileURL, fileURLToPath } from 'node:url';\nimport assert from 'node:assert/strict';\nconst root = process.env.FACETY_ROOT || process.cwd();\nconst imp = path => import(pathToFileURL(root + '/' + path));\nconst { runVouchExperiment } = await imp('src/vouch-experiment.mjs');\nconst { config } = await imp('test/support/vouch-experiment-fixture.mjs');\nconst { evaluateVouchAttribution } = await imp('studies/2026-10-26-trust-topology-condition-map/prior7-attribution.mjs');\nconst { prior7Sets } = await imp('test/support/prior7-set-verifier.mjs');\nconst sha = x => createHash('sha256').update(x).digest('hex');\nconst git = (...args) => execFileSync('git', ['-C', root, ...args], { encoding: 'utf8' }).trim();\nconst run = runVouchExperiment(config()), raw = Buffer.from(JSON.stringify(run)), gzip = gzipSync(raw);\nassert.ok(gunzipSync(gzip).equals(raw));\nconst op = { a: 'outside:a', b: 'outside:b', x: 'group', y: 'group' };\nconst genuine = { a: true, b: true, x: false, y: false };\nconst overlays = ['activated-records-cumulative', 'active-guarantees-terminal', 'probation-records-terminal', 'issuer-contacts-cumulative'].map(denominatorKind => ({ operatorBySubject: op, genuineBySubject: genuine, coalitionOperators: ['group'], denominatorKind }));\nconst outputs = overlays.map(e => {\n  const output = evaluateVouchAttribution(run, e), independent = prior7Sets(run, e);\n  assert.deepEqual(output.denominator.items, independent.sets[e.denominatorKind]);\n  assert.deepEqual(output.numerator.falseNewSubjects, independent.falseNew);\n  return { evaluation: e, output, independent };\n});\nconst honest = { ...overlays[0], genuineBySubject: { a: true, b: true, x: true, y: true } };\nconst genuineOutput = evaluateVouchAttribution(run, honest);\nassert.equal(genuineOutput.numerator.count, 0);\nassert.deepEqual(genuineOutput.boundary, outputs[0].output.boundary);\nassert.equal(JSON.stringify(run), raw.toString());\nconst paths = ['studies/2026-10-26-trust-topology-condition-map/prior7-attribution.mjs', 'test/prior7-attribution.test.mjs', 'test/support/prior7-set-verifier.mjs', 'studies/2026-10-26-trust-topology-condition-map/wp1-prior7-attribution-contract.md', 'src/vouch-experiment.mjs', 'src/vouch-experiment-config.mjs', 'test/support/vouch-experiment-fixture.mjs', 'studies/2026-10-26-trust-topology-condition-map/wp1-composition-fixture.json', 'studies/2026-10-26-trust-topology-condition-map/programme.json'];\nconst bindings = Object.fromEntries(paths.map(path => [path, { gitBlob: git('hash-object', path), sha256: sha(readFileSync(root + '/' + path)) }]));\nconst program = readFileSync(fileURLToPath(import.meta.url), 'utf8');\nconsole.log(JSON.stringify({ schema: 'facety-prior7-software-acceptance/v1', classification: 'diagnostic', base: git('rev-parse', 'HEAD'),\n  srcTree: git('rev-parse', 'HEAD:src'), originalTestTree: git('rev-parse', 'HEAD:test'), runtime: process.version, bindings,\n  witness: { configurations: 1, basis: 'Unchanged existing default composition SOFTWARE configuration, replay only; NOT a false-person/cut attack world or independent sample.',\n    encoding: 'gzip-base64', bytes: raw.length, sha256: sha(raw), gzipBytes: gzip.length, data: gzip.toString('base64'),\n    allProducerEnvironmentPeopleGenuine: run.config.environment.subjects.every(s => s.genuine === true), falseActIsNotFalsePerson: true },\n  outputs, genuineControl: { evaluation: honest, output: genuineOutput }, rawInputUnchanged: true,\n  program: { sha256: sha(program), code: program },\n  ceiling: 'Set/accounting conformance under supplied complete terminal records and passive static assumptions, not input authentication, a full Native transition/peak-liquidity verifier, verified personhood, independent author confirmation, empirical attack probability